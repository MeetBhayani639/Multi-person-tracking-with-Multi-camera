@"
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual Environments
venv/
env/
.venv/

# Torch, CV and large binaries
*.dll
*.pyd
*.so
*.dylib

# Model weights
*.pt
*.pth
*.onnx
*.tflite

# Videos / Outputs
outputs/
*.mp4
*.avi
*.mov

# OS Cache
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
"@ | Out-File -FilePath .gitignore -Encoding utf8